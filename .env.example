# Exobrain Environment Variables
# Copy this file to .env and fill in your values

# API keys for minmind AI integrations
OPENAI_API_KEY=sk-your-openai-key-here
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# MinMind database path (default: ~/.minmind/minmind.db)
# MINMIND_DB=~/.minmind/minmind.db
